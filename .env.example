# SLRNO Saxo-only runtime. No broker secrets belong in this file or Git.
# OAuth client/account credentials use a private mode-0600 JSON file.
# See docs/SAXO-SETUP.md. The runtime starts disarmed on every launch.
STOCKER_LOG_LEVEL=INFO
# Optional dashboard authentication; configure securely on the host.
# STOCKER_DASHBOARD_PASSWORD=
# STOCKER_DASHBOARD_PROXY_TOKEN=
# STOCKER_DASHBOARD_ORIGIN=https://your-existing-host
