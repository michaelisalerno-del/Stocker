# Install as /etc/stocker/stocker.env, owned root:stocker, mode 0640.
# Values below are names/placeholders only. Never commit the populated file.
STOCKER_GIT_COMMIT=REPLACE_WITH_DEPLOYED_GIT_COMMIT
STOCKER_CONTEXT_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
# Needed only when prospective.yaml enables after-session EODHD parity capture.
# Official TWS/IB Gateway socket recorder. The port is explicit and does not
# select or enable a paper/live execution mode.
IBKR_HOST=127.0.0.1
IBKR_PORT=REPLACE_WITH_SOCKET_PORT
IBKR_CLIENT_ID=71
IBKR_READ_ONLY=true
IBKR_MARKET_DATA_TYPE_REQUIRED=live
IBKR_ENABLE_LEVEL2=false
IBKR_LEVEL2_ROWS=5
IBKR_TOTAL_MARKET_DATA_LINES=100
IBKR_EXTERNALLY_RESERVED_LINES=0
IBKR_RESERVED_FUTURE_TRADING_LINES=12
IBKR_MAX_DEPTH=0
IBKR_MAX_TICK_BY_TICK=2
IBKR_MAX_CONCURRENT_SNAPSHOTS=2
IBKR_MAX_ACTIVE_OPTION_EPISODES=1
IBKR_MAX_OPTION_LINES_PER_EPISODE=8
IBKR_MAX_OPTION_SUBSCRIPTIONS=8
IBKR_CONNECTION_TIMEOUT_SECONDS=10
IBKR_RECONNECT_BACKOFF_SECONDS=2
IBKR_TWS_OR_GATEWAY_VERSION=REPLACE_WITH_GATEWAY_OR_TWS_VERSION
EODHD_API_TOKEN=REPLACE_WITH_SERVER_VENDOR_TOKEN
STOCKER_IBKR_API_PROVENANCE=/var/lib/stocker/ibkr-api/active-provenance.json
STOCKER_IBKR_API_UPDATE_STATUS=/var/lib/stocker/ibkr-api/status/update-status.json
