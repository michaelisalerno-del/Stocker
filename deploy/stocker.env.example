# Install as /etc/stocker/stocker.env, owned root:stocker, mode 0640.
# Values below are names/placeholders only. Never commit the populated file.
STOCKER_GIT_COMMIT=REPLACE_WITH_DEPLOYED_GIT_COMMIT
STOCKER_CONTEXT_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
STOCKER_IBKR_API_PROVENANCE=/var/lib/stocker/ibkr-api/active-provenance.json
STOCKER_IBKR_API_UPDATE_STATUS=/var/lib/stocker/ibkr-api/status/update-status.json
# Required only when web.authentication_enabled is true.
STOCKER_WEB_AUTH_TOKEN=REPLACE_WITH_RANDOM_TOKEN
