[Unit]
Description=Stocker V2 weekly checked compressed backup
Documentation=file:/opt/stocker/current/docs/plans/stocker-v2-platform.md
After=stocker-recorder.service
ConditionPathExists=/usr/local/libexec/stocker-prepare-v2-sqlite-boundary

[Service]
Type=oneshot
User=stocker-backup
Group=stocker-readers
WorkingDirectory=/opt/stocker/current
EnvironmentFile=-/etc/stocker/stocker-backup.env
ExecCondition=+/usr/local/libexec/stocker-prepare-v2-sqlite-boundary
ExecStart=/opt/stocker/current/.venv/bin/stocker-runtime backup create --database /var/lib/stocker/v2/stocker-v2.sqlite3 --destination /var/lib/stocker/backups-v2 --tier weekly
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/var/lib/stocker/v2
ReadWritePaths=/var/lib/stocker/v2/stocker-v2.sqlite3-shm
ReadWritePaths=/var/lib/stocker/backups-v2
