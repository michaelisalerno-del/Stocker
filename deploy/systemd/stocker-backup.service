[Unit]
Description=Online backup of the Stocker prospective SQLite database
After=stocker-recorder.service

[Service]
Type=oneshot
User=stocker
Group=stocker
WorkingDirectory=/opt/stocker/current
ExecStart=/opt/stocker/current/.venv/bin/stocker-prospective db backup --database /var/lib/stocker/prospective/prospective.sqlite3 --destination /var/lib/stocker/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stocker/backups
ReadOnlyPaths=/var/lib/stocker/prospective
