[Unit]
Description=Private X11 display for the manually authenticated IB Gateway
Documentation=file:/opt/stocker/current/docs/operations/prospective-server-runbook.md
PartOf=stocker-ibgateway.service

[Service]
Type=simple
User=stocker
Group=stocker
Environment=HOME=/var/lib/stocker
ExecStart=/usr/bin/Xvfb :71 -screen 0 1280x900x24 -nolisten tcp -noreset -auth /var/lib/stocker/ibgateway/.Xauthority
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/stocker /tmp
