[Unit]
Description=Verify the IB Gateway loopback and firewall boundary
Documentation=file:/opt/stocker/current/docs/operations/prospective-server-runbook.md
Requires=ufw.service
After=ufw.service
Before=stocker-ibgateway-loopback-proxy.socket stocker-ibgateway.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/stocker-verify-ibgateway-loopback-boundary
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
