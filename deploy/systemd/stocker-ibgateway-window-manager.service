[Unit]
Description=Private window manager for the manually authenticated IB Gateway
Documentation=file:/opt/stocker/current/docs/operations/prospective-server-runbook.md
Requires=stocker-ibgateway-display.service
After=stocker-ibgateway-display.service
PartOf=stocker-ibgateway.service
ConditionPathExists=/var/lib/ibgateway/.Xauthority
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ibgateway
Group=ibgateway
Environment=HOME=/var/lib/ibgateway
Environment=DISPLAY=:71
Environment=XAUTHORITY=/var/lib/ibgateway/.Xauthority
ExecStart=/usr/bin/openbox
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/ibgateway /tmp
