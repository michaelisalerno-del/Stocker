[Unit]
Description=Verify Stocker recorder readiness from advancing live market evidence
After=stocker-ibgateway.service stocker-recorder.service
Requires=stocker-recorder.service

[Service]
Type=oneshot
User=stocker
Group=stocker
WorkingDirectory=/opt/stocker/current
ExecStart=/opt/stocker/current/.venv/bin/python /usr/local/libexec/stocker-verify-recorder-session-readiness.py --database /var/lib/stocker/prospective/prospective.sqlite3 --expected-level1 21 --expected-bars 28 --maximum-quote-age-seconds 2 --maximum-bar-age-seconds 600 --required-distinct-boundaries 2 --attempts 70 --interval-seconds 10
TimeoutStartSec=750
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/stocker /opt/stocker/current
