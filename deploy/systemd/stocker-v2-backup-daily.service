[Unit]
Description=Stocker V2 daily checked compressed backup
Documentation=file:/opt/stocker/current/docs/plans/stocker-v2-platform.md
After=stocker-v2-recorder.service

[Service]
Type=oneshot
User=stocker-backup
Group=stocker-readers
WorkingDirectory=/opt/stocker/current
EnvironmentFile=-/etc/stocker/stocker-backup.env
CacheDirectory=stocker-v2-backup-work
CacheDirectoryMode=0750
ExecStart=/opt/stocker/current/.venv/bin/stocker-runtime backup create --database /var/lib/stocker/v2/stocker-v2.sqlite3 --destination /var/lib/stocker/backups-v2 --tier daily --working-directory /var/cache/stocker-v2-backup-work
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/var/lib/stocker/v2
ReadWritePaths=/var/lib/stocker/v2/stocker-v2.sqlite3-shm
ReadWritePaths=/var/lib/stocker/backups-v2
ReadWritePaths=/var/cache/stocker-v2-backup-work
