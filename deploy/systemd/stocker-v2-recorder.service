[Unit]
Description=Stocker V2 market-data-only recorder
Documentation=file:/opt/stocker/v2-current/docs/operations/stocker-v2-market-open-reliability.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=stocker-recorder
Group=stocker-readers
WorkingDirectory=/opt/stocker/v2-current
EnvironmentFile=-/etc/stocker/stocker-recorder.env
ExecStartPre=+/usr/local/libexec/stocker-prepare-v2-sqlite-boundary
ExecStartPre=/opt/stocker/v2-current/.venv/bin/stocker-runtime validate-recorder /etc/stocker/recorder.json --inputs /etc/stocker/market-data.json
ExecStart=/opt/stocker/v2-current/.venv/bin/stocker-runtime recorder run --config /etc/stocker/recorder.json --inputs /etc/stocker/market-data.json
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/var/lib/stocker/backups-v2
ReadWritePaths=/var/lib/stocker/v2

[Install]
WantedBy=multi-user.target
