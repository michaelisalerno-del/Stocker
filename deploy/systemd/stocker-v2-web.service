[Unit]
Description=Stocker V2 query-only web application
Documentation=file:/opt/stocker/v2-current/docs/plans/stocker-v2-platform.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/usr/local/libexec/stocker-prepare-v2-sqlite-boundary

[Service]
Type=simple
User=stocker-web
Group=stocker-readers
WorkingDirectory=/opt/stocker/v2-current
EnvironmentFile=/etc/stocker/stocker-v2-web.env
ExecCondition=+/usr/local/libexec/stocker-prepare-v2-sqlite-boundary
ExecStart=/opt/stocker/v2-current/.venv/bin/stocker-runtime web run --config /etc/stocker/web.json
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/var/lib/stocker/v2
ReadOnlyPaths=/var/lib/stocker/backups-v2
ReadWritePaths=/var/lib/stocker/v2/stocker-v2.sqlite3-shm

[Install]
WantedBy=multi-user.target
