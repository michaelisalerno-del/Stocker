[Unit]
Description=Stocker prospective read-only web application
Documentation=file:/opt/stocker/current/docs/operations/prospective-server-runbook.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/usr/local/libexec/stocker-prepare-web-sqlite-boundary

[Service]
Type=simple
User=stocker-web
Group=stocker-readers
WorkingDirectory=/opt/stocker/current
EnvironmentFile=/etc/stocker/stocker-web.env
ExecCondition=+/usr/local/libexec/stocker-prepare-web-sqlite-boundary
ExecStart=/opt/stocker/current/.venv/bin/stocker-prospective web run --config /etc/stocker/prospective.yaml
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadOnlyPaths=/var/lib/stocker
ReadWritePaths=/var/lib/stocker/prospective

[Install]
WantedBy=multi-user.target
