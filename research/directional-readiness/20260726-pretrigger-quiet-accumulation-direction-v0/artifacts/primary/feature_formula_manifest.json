{
  "activity_proxy": "historical_relative_activity; not asserted exchange volume",
  "activity_without_displacement": "sign(pressure_sum_25)*mean(max(activity_proxy_i,0))*(1-min(1,abs(net_return_25)/(path_length_25+epsilon)))",
  "break_failure_asymmetry": "1[low_i<min(previous_6_lows)]*(close_i-low_i)/(range_i+epsilon) - 1[high_i>max(previous_6_highs)]*(high_i-close_i)/(range_i+epsilon)",
  "clv": "(2*close_i-high_i-low_i)/(high_i-low_i+epsilon)",
  "direction_marker": "completed_bar_T_minus_1_close",
  "epsilon": 1e-12,
  "market_return": "log(market_close_i / market_close_(i-1))",
  "normalised_range": "(high_i - low_i) / close_(i-1)",
  "pre_entry_displacement": "log(entry_price / close_at_marker_T_minus_1)",
  "pressure_persistence": "mean(sign(signed_pressure_i)); zero contributes zero",
  "pressure_slope": "OLS slope of cumulative signed pressure over five bars",
  "primary_target": "log(close_of_second_future_bar / first_post_trigger_bar_open)",
  "primary_window_ordinals": [
    "T-5",
    "T-4",
    "T-3",
    "T-2",
    "T-1"
  ],
  "prior_completed_bar_atr": "shift(1) rolling mean over 14 completed true ranges by stock",
  "quiet_absorption_score": "quietness_25 * equal_weight_mean(13 development-standardised and [-3,+3]-clipped signed components)",
  "quietness": "sigmoid(-robust_z(range_sum_25))*sigmoid(-robust_z(path_length_25))",
  "relative_return": "r_i - market_r_i",
  "remaining_fraction": "abs(post_entry_return)/(abs(pre_entry_signed_return)+abs(post_entry_return)+epsilon)",
  "signed_absorption_divergence": "sign(pressure_sum_25)*(abs(robust_z(pressure_sum_25))-abs(robust_z(net_return_25)))",
  "signed_pressure": "exact audited signed_pressure snapshot on that bar close only; no interpolation or forward-fill; otherwise missing",
  "signed_return": "log(close_i / close_(i-1))",
  "trigger_bar": "completed_bar_T",
  "trigger_bar_excluded": true,
  "vwap": "causal session cumulative typical-price VWAP weighted by the existing positive activity field",
  "vwap_distance": "(close_i-vwap_i)/(prior_completed_bar_atr_i+epsilon)",
  "wick_asymmetry": "(min(open_i,close_i)-low_i - (high_i-max(open_i,close_i)))/(high_i-low_i+epsilon)"
}
