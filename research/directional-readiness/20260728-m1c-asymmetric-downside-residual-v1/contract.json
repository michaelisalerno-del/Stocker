    "terminal_price": "close of the third five-minute bar after entry",
    "movement": "absolute log(terminal_price / entry_price)",
    "previous_close_implied_denominator": "prior-close ATM IV * sqrt(15 / (252 * 390)) * sqrt(2 / pi)",
    "material_move_comparison": "strict_greater_than"
  },
  "direction_partition": {
    "method": "signed_endpoint_return",
    "DOWN_MOVE": "signed endpoint log return <= -previous-close implied denominator",
    "UP_MOVE": "signed endpoint log return >= previous-close implied denominator",
    "NO_MOVE": "absolute signed endpoint log return < previous-close implied denominator",
    "AMBIGUOUS_BOTH_WITHIN_BAR": "used only by the first-breach OHLC audit when both sides first breach in the same bar",
    "exact_probability_decomposition_supported": false,
    "mismatch_reason": "The frozen M1C event uses strict absolute_return > denominator, while the required direction partition assigns exact +/- denominator equality to a material direction.",
    "joint_probability_construction_allowed": false
  },
  "primary_population": {
    "unit": "existing fresh high-M1C episode",
    "freshness": "unchanged threshold crossing plus frozen 30-minute stock-session spacing",
    "required_tail_phases": [
      "FIRST_ENTRY",
      "RE_ENTRY"
    ],
    "persistent_checkpoint_rows_primary_support": false,
    "complete_predictors_required": true,
    "complete_primary_outcome_required": true
  },
  "features": [
    {
      "id": "D1",
      "name": "signed_return_5m",
      "formula": "log(current_complete_bar_close / preceding_same_session_bar_close)"
    },
    {
      "id": "D2",
      "name": "signed_return_15m",
      "formula": "log(current_complete_bar_close / same_session_close_three_bars_earlier)"
    },
    {
      "id": "D3",
      "name": "close_location_15m",
      "formula": "2 * ((current close - trailing three-bar low) / (trailing three-bar high - trailing three-bar low)) - 1",
      "zero_range": "missing_no_imputation"
    },
    {
      "id": "D4",
      "name": "distance_from_session_vwap_iv",
      "formula": "(current close - causal session typical-price VWAP) / (previous-close underlying price * previous-close implied 15-minute absolute log movement)",
      "vwap": "cumulative volume-weighted typical price using only same-stock same-session completed bars through the checkpoint",
      "fallback": "If reliable stock volume is unavailable, use only D1-D3; no substitute feature."
    }
  ],
