  "observable_definitions": {
    "close_location_within_opening_range": "(decision close - opening low) / (opening high - opening low)",
    "cross_sectional_dispersion_bps": "simultaneous-slate sample standard deviation of open-to-decision raw returns in bps",
    "current_true_range_bps": "decision-bar true range divided by previous completed close times 10000",
    "directional_close_persistence_ratio": "absolute signed sum divided by absolute sum of completed one-step opening returns",
    "distance_from_opening_high_bps": "10000 * (opening high - decision close) / opening high",
    "distance_from_opening_low_bps": "10000 * (decision close - opening low) / opening low",
    "historical_activity_proxy_shock": "log1p completed cumulative provider activity divided by causal prior same-stock same-ordinal expanding mean",
    "latest_one_bar_return_bps": "10000 * (decision_close / prior_completed_bar_close - 1)",
    "latest_three_bar_return_bps": "10000 * (decision_close / completed_close_three ordinals earlier - 1)",
    "mean_completed_bar_true_range_bps": "mean completed opening true range divided by each prior close times 10000",
    "open_to_decision_cohort_relative_return_bps": "open_to_decision_raw_return_bps minus leave-one-stock-out simultaneous-slate median",
    "open_to_decision_raw_return_bps": "10000 * (completed_decision_close / regular_session_open - 1)",
    "opening_gap_bps": "10000 * (regular_session_open / prior_regular_session_close - 1)",
    "opening_high_low_range_bps": "completed opening high-low range divided by session open times 10000",
    "opening_realized_volatility_bps": "population standard deviation of completed one-step opening close returns times 10000",
    "positive_close_fraction": "fraction of completed opening bars with close above open"
  },
